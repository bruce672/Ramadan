*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --gold: #d4af37;
  --gold-light: #f0d060;
  --gold-dark: #a07820;
  --deep-blue: #0a1628;
  --mid-blue: #0f2545;
  --sky: #1a4a7a;
  --teal: #00897b;
  --glass-bg: rgba(255,255,255,0.07);
  --glass-border: rgba(255,255,255,0.15);
  --glass-blur: blur(16px);
}

html, body {
  min-height: 100vh;
  font-family: 'Lato', sans-serif;
  color: #fff;
  background: var(--deep-blue);
  overflow-x: hidden;
}

#root {
  min-height: 100vh;
}

/* Animated gradient background */
.bg-animated {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: linear-gradient(135deg, #0a1628 0%, #0f2545 30%, #0a2a1f 60%, #1a0a2e 100%);
  background-size: 400% 400%;
  animation: gradientShift 12s ease infinite;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* Orbs */
.orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.18;
  z-index: 0;
  animation: float 8s ease-in-out infinite;
  pointer-events: none;
}
.orb-1 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, #d4af37, transparent);
  top: -100px; left: -100px;
  animation-delay: 0s;
}
.orb-2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, #00897b, transparent);
  bottom: -80px; right: -80px;
  animation-delay: -4s;
}
.orb-3 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, #1a4a7a, transparent);
  top: 50%; left: 50%;
  animation-delay: -2s;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-30px) scale(1.05); }
}

/* Particles */
.particle {
  position: fixed;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.6);
  pointer-events: none;
  z-index: 0;
  animation: particle-float linear infinite;
}

@keyframes particle-float {
  0% { transform: translateY(110vh) translateX(0); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateY(-10vh) translateX(40px); opacity: 0; }
}

/* Glass card */
.glass {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: 20px;
}

.glass-gold {
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.3);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-radius: 20px;
}

/* Gradient text */
.gradient-text {
  background: linear-gradient(135deg, var(--gold-light), var(--gold), #fff8dc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Pulse glow */
.pulse-glow {
  animation: pulseGlow 2.5s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 10px rgba(212,175,55,0.2), 0 0 30px rgba(212,175,55,0.1); }
  50% { box-shadow: 0 0 20px rgba(212,175,55,0.4), 0 0 60px rgba(212,175,55,0.2); }
}

/* Fade in up */
.fade-up {
  animation: fadeUp 0.7s ease forwards;
  opacity: 0;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
.delay-5 { animation-delay: 0.5s; }
.delay-6 { animation-delay: 0.6s; }

/* Prayer card hover */
.prayer-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  cursor: default;
}
.prayer-card:hover {
  transform: translateY(-4px) scale(1.02);
  border-color: rgba(212,175,55,0.5);
  box-shadow: 0 8px 40px rgba(212,175,55,0.15);
}

.prayer-card.active {
  background: rgba(212,175,55,0.12);
  border-color: rgba(212,175,55,0.5);
  box-shadow: 0 0 30px rgba(212,175,55,0.2);
}

/* Bismillah text */
.bismillah {
  font-family: 'Amiri', serif;
  font-size: clamp(1.4rem, 3vw, 2rem);
  color: var(--gold-light);
  text-shadow: 0 0 20px rgba(212,175,55,0.4);
  direction: rtl;
}

.arabic-verse {
  font-family: 'Amiri', serif;
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  line-height: 1.8;
  direction: rtl;
  color: #ffe88a;
  text-shadow: 0 0 15px rgba(212,175,55,0.3);
}

/* App layout */
.app-container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 2rem 1rem;
  max-width: 1100px;
  margin: 0 auto;
}

/* Header */
.header {
  text-align: center;
  margin-bottom: 2.5rem;
}
.header h1 {
  font-family: 'Cinzel', serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  letter-spacing: 0.05em;
  margin: 0.5rem 0;
}
.header .subtitle {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.header .owner-badge {
  display: inline-block;
  background: rgba(212,175,55,0.15);
  border: 1px solid rgba(212,175,55,0.4);
  border-radius: 50px;
  padding: 4px 18px;
  font-size: 0.8rem;
  color: var(--gold-light);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}

/* Grid */
.main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
@media (max-width: 768px) {
  .main-grid { grid-template-columns: 1fr; }
}

/* Clock */
.clock-display {
  font-family: 'Cinzel', serif;
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 600;
  letter-spacing: 0.05em;
}
.date-display {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.6);
  letter-spacing: 0.1em;
  margin-top: 0.3rem;
}

/* Countdown */
.next-prayer-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: rgba(255,255,255,0.5);
  margin-bottom: 0.4rem;
}
.countdown {
  font-family: 'Cinzel', serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: var(--gold-light);
}

/* Prayer list */
.prayers-grid {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.prayer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.2rem;
}
.prayer-icon { font-size: 1.4rem; margin-right: 0.75rem; }
.prayer-name { font-family: 'Cinzel', serif; font-weight: 600; font-size: 1rem; }
.prayer-time {
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--gold-light);
  letter-spacing: 0.05em;
}

/* Quran card */
.quran-card {
  grid-column: 1 / -1;
  padding: 2rem;
  text-align: center;
}

/* Location */
.location-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.65);
}

/* Loading spinner */
.spinner {
  width: 36px; height: 36px;
  border: 3px solid rgba(212,175,55,0.2);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin: 0 auto;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Footer */
.footer {
  text-align: center;
  margin-top: 2.5rem;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.08em;
}

/* Buttons */
.btn-gold {
  background: linear-gradient(135deg, var(--gold-dark), var(--gold));
  color: var(--deep-blue);
  border: none;
  border-radius: 50px;
  padding: 8px 22px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.2s;
  letter-spacing: 0.05em;
}
.btn-gold:hover { opacity: 0.88; transform: scale(1.04); }

/* Verse nav */
.verse-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-top: 1.2rem;
}

/* Scrollbar */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(212,175,55,0.3); border-radius: 3px; }
